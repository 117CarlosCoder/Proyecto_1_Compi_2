@startuml
!pragma layout smetana
top to bottom direction

skinparam defaultFontName "Segoe UI"
skinparam fontSize 10
skinparam roundCorner 6
skinparam shadowing false
skinparam packageStyle rectangle

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #343A40
    HeaderBackgroundColor #E9ECEF
}

title
<b>Diagrama de Arquitectura Completo — Compilador Multilenguaje (Fase 2)</b>
<i>Incluye la totalidad de capas, paquetes, clases, interfaces, records, enumeraciones y analizadores ANTLR4 del proyecto</i>
end title

