    }

    package "org.compi2.analisis_semantico (7 Clases)" #DCEDC8 {
        class TablaSimbolos <<Entorno Global, Pila Ámbitos y Clases>>
        class Ambito <<Marco Léxico / Función / Ciclo / Switch>>
        class Simbolo <<Entrada de Símbolo y Offset>>
        class ContadorDesplazamiento <<Asignador de Offsets>>
        class ComprobadorTipos <<Matriz de Compatibilidad y Casteo>>
        class ErrorSemantico <<Error con Archivo y Ámbito>>
        class YSangriaToken <<Filtro Léxico INDENT/DEDENT>>
    }

    package "org.compi2.tipos (3 Clases/Enums)" #DCEDC8 {
        class Tipo <<Descriptor de Tipo Primitivo / Compuesto / POO>>
        enum TipoBase {
            BOOLEANO, CARACTER, ENTERO, DECIMAL,
            CADENA, VOID, NULO, ERROR,
            ARREGLO, OBJETO_CLASE, ESTRUCTURA, FUNCION
