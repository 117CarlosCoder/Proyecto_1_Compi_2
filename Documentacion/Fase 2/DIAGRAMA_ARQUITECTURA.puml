}

' ============================================================================
' CAPA 4: GENERACIÓN DE CÓDIGO DE TRES DIRECCIONES (C3D)
' ============================================================================
package "CAPA 4: Síntesis de Código Intermedio de Tres Direcciones (C3D)" #F3E5F5 {

    package "org.compi2.c3d (7 Clases + 3 Inner)" #E1BEE7 {
        class GeneradorC3D <<Orquestador C3D, Sentencias, Control y Funciones>>
        class ContenedorC3D <<Almacén de Cuartetas y Metadatos RISC-V>>
        enum "ContenedorC3D.TipoRutinaRiscV" as TipoRutinaRiscV {
            READ_DECIMAL
            DECIMAL_TO_HEAP
        }
        class "ContenedorC3D.RangoRutinaRiscV" as RangoRutinaRiscV <<Record>>
        enum "ContenedorC3D.AccionCuartetaRiscV" as AccionCuartetaRiscV {
            ESCALAR_ARG1_X10000
            ESCALAR_ARG2_X10000
            MUL_DECIMAL
            DIV_DECIMAL
        }
        class Cuarteta <<Instrucción (op, arg1, arg2, res)>>
        enum TipoOperadorC3D {
            SUMA, RESTA, MULTIPLICACION, DIVISION, DIVISION_ENTERA,
            MODULO, MENOS_UNARIO, ASIGNACION, ETIQUETA, GOTO,
            IF_IGUAL, IF_DIFERENTE, IF_MENOR, IF_MENOR_IGUAL,
            IF_MAYOR, IF_MAYOR_IGUAL, ACCESO_STACK, ASIGNACION_STACK,
            ACCESO_HEAP, ASIGNACION_HEAP, ACCESO_BUFFER, ASIGNACION_BUFFER,
            PRINT_INT, PRINT_DOUBLE, PRINT_CHAR, READ_STR
        }
        class GestorTemporales <<Generador t0..tn>>
        class GestorEtiquetas <<Generador L0..Ln>>
        class PlantillaC <<Envoltura C Ejecutable (stack, heap, buffer_str)>>
    }

    package "org.compi2.c3d.generadores (3 Clases + 2 Records)" #F3E5F5 {
        class ContextoC3D <<Memoria P/H, Temporales Activos, Herencia y VCall>>
        class "ContextoC3D.SitioLlamada" as SitioLlamada <<Record>>
        class "ContextoC3D.InfoDespachadorVirtual" as InfoDespachadorVirtual <<Record>>
        class GeneradorExpresiones <<Expresiones, Arreglos N-D, Objetos y Llamadas>>
        class RutinasC3D <<Rutinas Nativas: PrintStr, ReadNum, ReadStr, Concat>>
    }
}

' ============================================================================
' CAPA 5: BACKEND DE CÓDIGO OBJETO Y EJECUCIÓN (RISC-V)
' ============================================================================
package "CAPA 5: Backend Assembler RISC-V (RV32IM) y Simulador de Ejecución" #FFEBEE {

    package "org.compi2.riscv (2 Clases + 2 Records)" #FFCDD2 {
        class GeneradorRiscV <<Traductor C3D a Ensamblador RV32IM>> {
            • Secciones .data y .text (.globl main)
            • Registros s0(P), s1(H), s2(&stack), s3(&heap), s4(&buffer_str), s5(&~__temp_mem)
            • Punto fijo decimal (x10000) y ~__print_decimal
        }
        class SimuladorRiscV <<Intérprete RV32IM + Lanzador Terminal + Venus>> {
            • 32 registros enteros y memoria paginada (64 KB)
            • Syscalls ecall (1, 4, 8, 10, 11, 93)
            • Consola externa OS para lectura interactiva
        }
        class "SimuladorRiscV.Instruccion" as InstruccionRiscV <<Record>>
        class "SimuladorRiscV.MemOp" as MemOpRiscV <<Record>>
    }
}

' ============================================================================
' CONEXIONES ARQUITECTÓNICAS PRINCIPALES
' ============================================================================

' Capa 1 (UI)
Main --> VentanaPrincipal : inicia aplicación
Main --> RenderizadorGraphviz : configura loggers
VentanaPrincipal *-- PanelEditorTexto
VentanaPrincipal *-- PanelConsola
VentanaPrincipal *-- PanelArbolProyecto
VentanaPrincipal *-- PanelImagenZoom
VentanaPrincipal *-- AccionesProyecto
VentanaPrincipal *-- ModeloTablaSimbolos
VentanaPrincipal *-- ModeloTablaErrores
VentanaPrincipal --> TareaCompilacion : lanza en background
VentanaPrincipal --> DialogoTabla : abre reportes
VentanaPrincipal --> RenderizadorGraphviz : renderiza AST
VentanaPrincipal --> SimuladorRiscV : ejecuta Assembler (.s)

PanelEditorTexto *-- EditorKitPlantilla
PanelEditorTexto *-- NumeroLinea
EditorKitPlantilla --> VistaSintaxis : instancia
VistaSintaxis --> Simbolo : coloreado semántico

PanelArbolProyecto *-- NodoArchivo
PanelArbolProyecto *-- RendererNodoArchivo
PanelArbolProyecto *-- AccionesProyecto

' Capa 1 -> Capa 2
TareaCompilacion --> OrquestadorCompilacion : 1. compilarArchivo()
TareaCompilacion --> GeneradorDot : genera grafos DOT
TareaCompilacion o-- ResultadoCompilacion

' Capa 2 (Orquestador y ANTLR4)
OrquestadorCompilacion --> GestorImports : 2. resuelve imports (.y / .z)
GestorImports *-- ResolucionImport
GestorImports --> ArchivoFuente : instancia y valida
ArchivoFuente *-- TipoLenguaje
ArchivoFuente o-- NodoAST

OrquestadorCompilacion --> piglatinLexer : tokeniza .pig
piglatinLexer --> piglatinParser
piglatinParser --> ConstructorAstPigLatin
ConstructorAstPigLatin --|> piglatinBaseVisitor

OrquestadorCompilacion --> yLexer : tokeniza .y
yLexer --> YSangriaToken : inyecta INDENT/DEDENT
YSangriaToken --> yParser
yParser --> ConstructorAstY
ConstructorAstY --|> yBaseVisitor

OrquestadorCompilacion --> zetarianoLexer : tokeniza .z
zetarianoLexer --> zetarianoParser
zetarianoParser --> ConstructorAstZetariano
ConstructorAstZetariano --|> zetarianoBaseVisitor

ConstructorAstPigLatin --> UtilidadesAst
ConstructorAstY --> UtilidadesAst
ConstructorAstZetariano --> UtilidadesAst

OrquestadorCompilacion --> CustomErrorListener : adjunta a Lexers/Parsers
CustomErrorListener *-- ErrorCompilacion
ErrorCompilacion *-- TipoError
ErrorSemantico --|> ErrorCompilacion

' Capa 2 -> Capa 3 (AST y Semántica)
ConstructorAstPigLatin --> NodoPrograma : 3. construye AST .pig
ConstructorAstY --> NodoProgramaY : 3. construye AST .y
ConstructorAstZetariano --> NodoUnidadCompilacionZ : 3. construye AST .z

ModuloSemantico --|> NodoAST
NodoPrograma ..|> ModuloSemantico
NodoProgramaY ..|> ModuloSemantico
NodoUnidadCompilacionZ ..|> ModuloSemantico

NodoPrograma *-- InfoImport
NodoPrograma o-- NodoAST : declaraciones / MAIOR
NodoProgramaY *-- NodoEstructura
NodoProgramaY *-- NodoFuncion
NodoUnidadCompilacionZ *-- NodoClase
NodoClase *-- NodoDeclaracion : campos
NodoClase *-- NodoConstructor : constructores
NodoClase *-- NodoFuncion : métodos
NodoConstructor *-- Parametro
NodoConstructor o-- NodoLlamadaSuper : super(...)
NodoFuncion *-- Parametro
NodoSwitch *-- CasoSwitch

OrquestadorCompilacion --> ModuloSemantico : 4. ejecuta Pasadas 1, 1.5 y 2
ModuloSemantico --> TablaSimbolos : registra y valida
NodoAST --> TablaSimbolos : comprueba tipos y ámbitos
NodoAST --> ComprobadorTipos : valida operaciones
NodoAST --> ErrorSemantico : reporta errores

TablaSimbolos *-- Ambito
TablaSimbolos *-- Simbolo
TablaSimbolos *-- Tipo
Ambito *-- ContadorDesplazamiento
Simbolo *-- Tipo
Tipo *-- TipoBase
Tipo *-- Visibilidad

' Capa 2 -> Capa 4 (Generación C3D)
OrquestadorCompilacion --> GeneradorC3D : 5. compilarConFunciones()
GeneradorC3D *-- ContextoC3D
GeneradorC3D *-- GeneradorExpresiones
GeneradorC3D --> PlantillaC : empaqueta código .c
ContextoC3D *-- ContenedorC3D
ContextoC3D *-- RutinasC3D
ContextoC3D *-- SitioLlamada
ContextoC3D *-- InfoDespachadorVirtual
ContextoC3D o-- TablaSimbolos
GeneradorExpresiones o-- ContextoC3D
RutinasC3D o-- ContenedorC3D

ContenedorC3D *-- Cuarteta
ContenedorC3D *-- GestorTemporales
ContenedorC3D *-- GestorEtiquetas
ContenedorC3D *-- RangoRutinaRiscV
ContenedorC3D *-- TipoRutinaRiscV
ContenedorC3D *-- AccionCuartetaRiscV
Cuarteta *-- TipoOperadorC3D

' Capa 2/4 -> Capa 5 (Backend RISC-V)
OrquestadorCompilacion --> GeneradorRiscV : 6. generarCodigo(ContenedorC3D)
GeneradorRiscV --> ContenedorC3D : traduce cuartetas y metadatos
OrquestadorCompilacion --> ResultadoCompilacion : 7. empaqueta C3D + RISC-V
SimuladorRiscV *-- InstruccionRiscV
SimuladorRiscV *-- MemOpRiscV

@enduml
