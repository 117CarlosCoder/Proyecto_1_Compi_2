' ============================================================================
' CAPA 3: REPRESENTACIÓN INTERMEDIA (AST), ANÁLISIS SEMÁNTICO Y TIPOS
' ============================================================================
package "CAPA 3: Árbol de Sintaxis Abstracta (AST), Semántica de 3 Pasadas y Tipos" #E8F5E9 {

    package "org.compi2.ast" #A5D6A7 {
        interface NodoAST {
            + comprobar(ts: TablaSimbolos, errores: List<ErrorSemantico>): Tipo
        }
        interface ModuloSemantico {
            + registrarEnTablaSimbolos(ts: TablaSimbolos, errores: List<ErrorSemantico>): void
            + comprobarCuerpos(ts: TablaSimbolos, errores: List<ErrorSemantico>): void
        }
    }

    package "org.compi2.ast.sentencias (22 Clases + 2 Inner)" #C8E6C9 {
        class NodoPrograma <<Raíz .pig>>
        class "NodoPrograma.InfoImport" as InfoImport <<Inner Class>>
        class NodoProgramaY <<Raíz .y>>
        class NodoUnidadCompilacionZ <<Raíz .z>>
        class NodoClase <<POO Clase / Herencia>>
        class NodoConstructor <<POO Constructor>>
        class NodoLlamadaSuper <<POO super(...)>>
        class NodoFuncion <<Función / Método>>
        class Parametro <<Parámetro Formal>>
        class NodoEstructura <<Struct Lenguaje Y>>
        class NodoDeclaracion <<Var / Const / Arreglo / Campo>>
        class NodoAsignacion <<Asignación Simple / Compuesta>>
        class NodoIf <<Condicional If-Else>>
        class NodoSwitch <<Condicional Switch-Case>>
        class "NodoSwitch.CasoSwitch" as CasoSwitch <<Inner Class>>
        class NodoWhile <<Ciclo While / Dum>>
        class NodoDoWhile <<Ciclo Do-While / Facere>>
        class NodoFor <<Ciclo For / Per>>
        class NodoBreak <<Control Break>>
        class NodoContinue <<Control Continue>>
        class NodoRetorno <<Control Return>>
        class NodoImprimir <<Salida Estándar>>
        class NodoLectura <<Entrada Estándar>>
    }

    package "org.compi2.ast.expresiones (13 Clases)" #C8E6C9 {
        class NodoLiteral <<Entero, Decimal, Cadena, Char, Bool, Null>>
        class NodoIdentificador <<Variable / Símbolo>>
        class NodoOperacionBinaria <<Aritmética, Relacional, Lógica, Concat>>
        class NodoOperacionUnaria <<Negación, ++, -->>
        class NodoExpresionTernaria <<cond ? verd : falso>>
        class NodoLlamadaFuncion <<Invocación Global>>
        class NodoLlamadaMetodo <<Invocación POO / Polimórfica>>
        class NodoInstanciacionObjeto <<new Clase(...)>>
        class NodoInstanciacionArreglo <<new Tipo[d1][d2]...>>
        class NodoAccesoArreglo <<arr[i][j]...>>
        class NodoAccesoMiembro <<obj.campo / this.campo / super.metodo>>
