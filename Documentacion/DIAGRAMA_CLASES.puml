@startuml
!pragma layout smetana

skinparam classAttributeIconSize 0
skinparam defaultFontName "Segoe UI"
skinparam fontSize 10
skinparam roundCorner 6
skinparam shadowing false
skinparam packageBackgroundColor #F8F9FA
skinparam packageBorderColor #6C757D
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #343A40
skinparam classHeaderBackgroundColor #E9ECEF

title
Diagrama de Clases - Compilador Multilenguaje (PigLatin, Y, Zetariano)
end title

package "org.compi2" {
    class Main {
        {static} +main(args: String[]): void
    }

    class VentanaPrincipal {
        -panelEditor: PanelEditorTexto
        -panelConsola: PanelConsola
        -modeloSimbolos: ModeloTablaSimbolos
        -modeloErrores: ModeloTablaErrores
        -panelImagenZoom: PanelImagenZoom
        -panelArbolProyecto: PanelArbolProyecto
        -areaCodigoDot: JTextArea
        -areaCodigoC3D: JTextArea
        -barraEstado: JLabel
        -etiquetaArchivo: JLabel
        -archivoActual: File
        -tareaActual: TareaCompilacion
        +iniciarCompilacion(): void
        +cancelarCompilacion(): void
        +mostrarTablaSimbolos(): void
        +mostrarTablaErrores(): void
        +abrirArchivo(f: File): void
        +guardarArchivo(): void
        +guardarArchivoComo(): void
        -configurarAtajosTeclado(): void
        -construirBarraHerramientas(): JToolBar
    }
}

package "org.compi2.orquestador" {
    enum TipoLenguaje {
        PIG_LATIN
        Y
        ZETARIANO
        DESCONOCIDO
        {static} +desdeExtension(ext: String): TipoLenguaje
    }

    class ArchivoFuente {
        -identificador: String
        -rutaAbsoluta: Path
        -nombreArchivo: String
        -nombreBase: String
        -lenguaje: TipoLenguaje
        -contenido: String
        -parseTree: ParseTree
        -ast: NodoAST
        +esPigLatin(): boolean
        +esY(): boolean
        +esZetariano(): boolean
        {static} -normalizarSeparadores(s: String): String
    }

    class GestorImports {
        -archivosImportados: Map<String, ArchivoFuente>
        -rutasVisitadas: Set<Path>
        -directorioBase: Path
        +procesarImports(raiz: ArchivoFuente): void
        +resolverRuta(importStr: String): Path
        +getArchivosImportados(): Map<String, ArchivoFuente>
        +getOrdenImportacion(): List<ArchivoFuente>
    }

    class ResultadoCompilacion {
        -exito: boolean
        -codigoC3D: String
        -archivosImportados: Map<String, ArchivoFuente>
        -tablaSimbolos: TablaSimbolos
        -errores: List<ErrorCompilacion>
        -parseTreePrincipal: ParseTree
        +tieneErrores(): boolean
        +getCantidadErrores(): int
        +getCantidadSimbolos(): int
    }

    class OrquestadorCompilacion {
        -gestorImports: GestorImports
        -tablaSimbolos: TablaSimbolos
        -errores: List<ErrorCompilacion>
        +compilarArchivo(archivoPig: File): ResultadoCompilacion
        +compilarArchivo(rutaArchivoPig: Path): ResultadoCompilacion
        -compilarPigLatin(contenido: String, nombre: String): ParseTree
        -compilarModuloY(contenido: String, nombre: String): ParseTree
        -compilarModuloZeta(contenido: String, nombre: String): ParseTree
        -ejecutarPasadaSemantica1(ast: NodoAST, af: ArchivoFuente): void
        -ejecutarPasadaSemantica2(ast: NodoAST, af: ArchivoFuente): void
        -generarC3D(raizPig: NodoAST): String
    }
}

package "org.compi2.errores" {
    enum TipoError {
        LEXICO
        SINTACTICO
        SEMANTICO
        -etiqueta: String
        +getEtiqueta(): String
    }

    abstract class ErrorCompilacion {
        #tipo: TipoError
        #mensaje: String
        #origen: String
        #linea: int
        #columna: int
        +getTipo(): TipoError
        +getMensaje(): String
        +getOrigen(): String
        +getLinea(): int
        +getColumna(): int
        +toString(): String
    }

    class CustomErrorListener {
        -tipoFijo: TipoError
        -origen: String
        -errores: List<ErrorCompilacion>
        +syntaxError(recognizer: Object, offendingSymbol: Object, line: int, charPos: int, msg: String, e: Object): void
        +getErrores(): List<ErrorCompilacion>
        +tieneErrores(): boolean
    }
}

